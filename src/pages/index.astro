---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Docs from '../components/Docs.astro';
import Steps from '../components/Steps.astro';
import CallbackSection from '../components/CallbackSection.astro';
import PackagesBlock from '../components/islands/PackagesBlock';
import { contacts, social } from '../lib/data';
import lab1 from '../assets/img/lab-964eb733.jpg';
import lab2 from '../assets/img/lab-4caaa27e.jpg';
import lab3 from '../assets/img/lab-eb3896da.jpg';

const services = [
  { href: '/stroitelnyj-kontrol', icon: 'helmet', title: 'Строительный контроль', text: 'Контроль работ на объекте по проекту и нормам, приёмка скрытых работ, исполнительная документация.' },
  { href: '/kontrol-monolita', icon: 'grid', title: 'Контроль прочности монолита', text: 'Сплошной контроль прочности бетона в монолитных конструкциях. Пакеты от 75 000 ₽ в месяц.' },
  { href: '/laboratoriya', icon: 'flask', title: 'Испытательная лаборатория', text: 'Бетон, растворы, нерудные материалы, грунты, асфальтобетон, металл и сварные соединения.' },
  { href: '/elektrolaboratoriya', icon: 'bolt', title: 'Электро\u00ADлаборатория', text: 'Приёмо-сдаточные испытания и измерения электроустановок напряжением до 1000 В.' },
  { href: '/obsledovanie', icon: 'search', title: 'Обследование зданий', text: 'Оценка технического состояния конструкций с выдачей технического отчёта.' },
];
---
<Base title="НИЦ СМК: строительный контроль и испытательная лаборатория" description="Строительный контроль, контроль прочности монолита, аккредитованная лаборатория, электролаборатория и обследование зданий в Москве. КП онлайн за минуту.">
  <section>
    <div class="container home-hero">
      <div style="display:flex;flex-direction:column;gap:28px">
        <span class="badge-dot"><span aria-hidden="true"></span>Аккредитованная испытательная лаборатория · ГОСТ ISO/IEC 17025-2019</span>
        <h1 class="h1">Строительный контроль и&nbsp;испытания <span class="marker">полного цикла</span></h1>
        <p class="lead" style="max-width:580px">Строительный контроль, контроль прочности монолитных конструкций, лабораторные и электротехнические испытания, обследование зданий. Москва и Московская область.</p>
        <div style="display:flex;flex-wrap:wrap;gap:12px">
          <a href="/kalkulyator" class="btn btn--accent btn--lg">Получить предложение <Icon name="arrow" size={18} width={2.2} /></a>
          <a href="#docs" class="btn btn--outline btn--lg">Документы и допуски</a>
        </div>
      </div>
      <div class="comp-card">
        <h2 style="margin:0 0 4px;font-size:18px;font-weight:800">Подтверждённая компетентность</h2>
        <div class="comp-card__i"><Icon name="medal" size={22} stroke="#F5C02B" width={1.8} /><div><div style="font-weight:700">Аттестат аккредитации № RU.АСК.ИЛ.1132</div><div class="comp-card__s">Испытательная лаборатория · 28 объектов испытаний</div></div></div>
        <div class="comp-card__i"><Icon name="bolt" size={22} stroke="#F5C02B" width={1.8} /><div><div style="font-weight:700">Электролаборатория № 10041</div><div class="comp-card__s">Зарегистрирована в Ростехнадзоре · до 1000 В</div></div></div>
        <div class="comp-card__i"><Icon name="shield" size={22} stroke="#F5C02B" width={1.8} /><div><div style="font-weight:700">Членство в СРО</div><div class="comp-card__s">Инженерные изыскания, проектирование, строительство</div></div></div>
      </div>
    </div>
  </section>

  <section class="container" aria-label="Цифры">
    <div class="stats">
      <div><b>350+</b><span>объектов сопровождено</span></div>
      <div><b>с 2020</b><span>года на рынке</span></div>
      <div><b>28</b><span>объектов испытаний в области аккредитации</span></div>
      <div><b>Онлайн</b><span>коммерческое предложение в калькуляторе</span></div>
    </div>
  </section>

  <section class="container" style="padding-top:112px;padding-bottom:40px" aria-labelledby="dir-h">
    <div class="section-head">
      <div class="eyebrow">Направления</div>
      <h2 class="h2" id="dir-h" style="font-size:clamp(26px,3vw,40px)">Пять направлений, один подрядчик</h2>
    </div>
    <div class="grid grid--200">
      {services.map((s) => (
        <a href={s.href} class="card service-card">
          <span class="icon-tile"><Icon name={s.icon} size={26} stroke="#14171A" width={1.8} /></span>
          <h3 class="card-title" lang="ru">{s.title}</h3>
          <p>{s.text}</p>
          <span class="link-arrow">Подробнее <Icon name="arrow" size={18} width={2.2} /></span>
        </a>
      ))}
    </div>
  </section>

  <section id="pakety" class="container" style="padding-top:64px;padding-bottom:40px;scroll-margin-top:80px">
    <PackagesBlock client:visible phone={contacts.phone} idPrefix="pk-home" />
  </section>

  <section class="container" style="padding-top:24px" aria-label="Рейтинг">
    <a href={social.yandexReviews} class="rating" rel="noopener">
      <div style="display:flex;align-items:center;gap:20px;flex-wrap:wrap">
        <span style="font-family:var(--f-display);font-size:44px;font-weight:600;line-height:1">4,3</span>
        <div>
          <div style="display:flex;gap:3px" role="img" aria-label="Рейтинг 4,3 из 5">
            {[1, 2, 3, 4, 5].map((i) => <svg width="20" height="20" viewBox="0 0 24 24" fill={i <= 4 ? '#F5C02B' : '#E2E2DC'} aria-hidden="true"><path d="m12 2 3 7 7 .6-5.3 4.7L18.5 22 12 18l-6.5 4 1.8-7.7L2 9.6 9 9z" /></svg>)}
          </div>
          <div style="margin-top:4px;font-weight:700">Рейтинг на Яндекс Картах</div>
          <div style="font-size:14px;color:var(--muted)">Клиенты отмечают оперативность, качество и соблюдение сроков</div>
        </div>
      </div>
      <span class="link-arrow">Читать отзывы <Icon name="arrow" size={18} width={2.2} /></span>
    </a>
  </section>

  <section class="container" style="padding-top:72px" aria-labelledby="lab-h">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:32px;align-items:center">
      <div class="home-gal">
        <figure class="photo" style="grid-column:span 2;border-radius:20px"><Photo src={lab1} alt="Испытательная лаборатория НИЦ СМК: рабочие места и оборудование" sizes="(max-width: 900px) 100vw, 620px" /></figure>
        <figure class="photo" style="border-radius:20px"><Photo src={lab2} alt="Испытательный пресс для испытания образцов бетона" sizes="(max-width: 900px) 50vw, 310px" widths={[320, 640]} /></figure>
        <figure class="photo" style="border-radius:20px"><Photo src={lab3} alt="Керны и образцы бетона в лаборатории" sizes="(max-width: 900px) 50vw, 310px" widths={[320, 640]} /></figure>
      </div>
      <div style="display:flex;flex-direction:column;gap:16px">
        <div class="eyebrow">Собственная лаборатория</div>
        <h2 class="h2 h2--sm" id="lab-h">Испытываем сами, без посредников</h2>
        <p style="margin:0;color:var(--text-2);font-size:17px">Аккредитованная лаборатория в Москве на ул. Вилюйской: бетон, растворы, грунты, щебень, асфальтобетон, металл и сварные соединения. Протоколы испытаний выдаём сами, без сторонних подрядчиков и лишних сроков.</p>
        <a href="/laboratoriya" class="btn btn--dark" style="align-self:flex-start">Смотреть лабораторию</a>
      </div>
    </div>
  </section>

  <section id="docs" class="container" style="padding-top:72px;padding-bottom:72px;scroll-margin-top:80px" aria-labelledby="docs-h">
    <div class="card" style="border-radius:var(--radius-block);padding:clamp(28px,5vw,56px)">
      <div class="section-head section-head--row" style="margin-bottom:32px">
        <div style="max-width:640px">
          <div class="eyebrow">Документы и допуски</div>
          <h2 class="h2 h2--sm" id="docs-h" style="margin-top:10px">Работаем официально</h2>
        </div>
        <p style="margin:0;max-width:420px;color:var(--muted)">Копии документов доступны по ссылкам ниже. Заверенные копии направим вместе с коммерческим предложением.</p>
      </div>
      <Docs />
    </div>
  </section>

  <section class="container" style="padding-top:40px;padding-bottom:56px" aria-labelledby="how-h">
    <div class="section-head">
      <div class="eyebrow">Порядок работы</div>
      <h2 class="h2" id="how-h" style="font-size:clamp(26px,3vw,40px)">От заявки до комплекта документов</h2>
    </div>
    <Steps items={[
      ['Заявка', 'Уточняем задачу и определяем объём работ.'],
      ['Договор', 'Направляем КП, согласуем сроки, заключаем договор.'],
      ['Работы', 'Выезд на объект, отбор проб, испытания и контроль.'],
      ['Документы', 'Протоколы, отчёты и исполнительная документация.'],
    ]} />
  </section>

  <CallbackSection />
</Base>
