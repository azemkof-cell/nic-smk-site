---
import Base from '../layouts/Base.astro';
import { contacts, phoneHref } from '../lib/data';
---
<Base title="Страница не найдена | НИЦ СМК" description="Такой страницы нет. Посчитайте стоимость в калькуляторе или свяжитесь с нами." noindex>
  <section class="container" style="padding-top:72px;padding-bottom:120px">
    <div class="on-ink" style="border-radius:var(--radius-block);padding:clamp(28px,6vw,72px);display:flex;flex-direction:column;gap:20px;align-items:flex-start">
      <span style="font-family:var(--f-display);font-size:clamp(72px,14vw,160px);font-weight:700;line-height:.9;color:var(--accent)">404</span>
      <h1 class="h1 h1--sm">Такой страницы нет</h1>
      <p class="lead">Возможно, адрес изменился после переезда сайта. Посчитайте стоимость работ в калькуляторе или свяжитесь с нами, подскажем.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a href="/kalkulyator" class="btn btn--accent btn--lg">Калькулятор по объекту</a>
        <a href="/kontakty" class="btn btn--ghost btn--lg">Контакты</a>
        <a href={phoneHref} class="btn btn--ghost btn--lg">{contacts.phone}</a>
      </div>
      <a href="/" style="color:var(--on-ink)">На главную</a>
    </div>
  </section>
</Base>
