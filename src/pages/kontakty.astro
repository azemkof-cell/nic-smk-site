---
import Base from '../layouts/Base.astro';
import Crumbs from '../components/Crumbs.astro';
import Icon from '../components/Icon.astro';
import CallbackForm from '../components/islands/CallbackForm';
import { contacts, phoneHref, emailHref, requisites, social } from '../lib/data';

const crumbs = [{ name: 'Контакты', href: '/kontakty' }];
const R = requisites.company;
const pick = (names: string[]) => R.filter((r) => names.includes(r.field));
const groups = [
  { title: 'ОРГАНИЗАЦИЯ', rows: pick(['Полное наименование', 'Сокращённое наименование', 'ИНН / КПП', 'ОГРН', 'Юридический адрес', 'Фактический адрес (лаборатория)', 'Генеральный директор']) },
  { title: 'БАНКОВСКИЕ РЕКВИЗИТЫ', rows: pick(['Расчётный счёт', 'Банк', 'Корреспондентский счёт', 'БИК']) },
  { title: 'КОДЫ СТАТИСТИКИ', rows: pick(['ОКПО', 'ОКАТО', 'ОКТМО', 'ОКОГУ / ОКФС / ОКОПФ']) },
];
const copyText = R.map((r) => r.field + ': ' + r.value).join('\n') + '\nТелефон: ' + contacts.phone + '\nE-mail: ' + contacts.email;
---
<Base title="Контакты и реквизиты — НИЦ СМК" description="Лаборатория НИЦ СМК: Москва, ул. Вилюйская, д. 11, стр. 3. Телефон +7 (916) 006-52-06, Пн–Пт 09:00–18:00. Реквизиты ООО «НИЦ СМК» для договора и оплаты." crumbs={crumbs}>
  <section class="container" style="padding-top:40px;padding-bottom:72px">
    <Crumbs items={crumbs} />
    <h1 class="h1 h1--md" style="margin:32px 0 40px">Свяжитесь с нами</h1>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:24px;align-items:start">
      <div style="display:flex;flex-direction:column;gap:16px">
        <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr))">
          <a href={phoneHref} class="card service-card" style="border-radius:18px;gap:6px"><span style="font-size:14px;color:var(--muted)">Телефон</span><span style="font-weight:800;font-size:19px">{contacts.phone}</span></a>
          <a href={emailHref} class="card service-card" style="border-radius:18px;gap:6px"><span style="font-size:14px;color:var(--muted)">E-mail</span><span style="font-weight:800;font-size:17px;overflow-wrap:anywhere">{contacts.email}</span></a>
          <div class="card" style="border-radius:18px"><div style="font-size:14px;color:var(--muted)">Адрес лаборатории</div><div style="font-weight:800;font-size:17px;margin-top:6px">Москва, ул. Вилюйская, д.&nbsp;11, стр.&nbsp;3</div></div>
          <div class="card" style="border-radius:18px"><div style="font-size:14px;color:var(--muted)">Режим работы</div><div style="font-weight:800;font-size:17px;margin-top:6px">{contacts.hours}</div></div>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          <a href={social.telegram} class="btn btn--dark" style="flex:1 1 140px" rel="noopener">Telegram</a>
          <a href={social.whatsapp} class="btn btn--dark" style="flex:1 1 140px" rel="noopener">WhatsApp</a>
          <a href={social.max} class="btn btn--dark" style="flex:1 1 140px" rel="noopener">MAX</a>
        </div>
        <div class="card" style="border-radius:18px;display:flex;flex-direction:column;gap:14px">
          <h2 style="margin:0;font-weight:800;font-size:17px">Как добраться до лаборатории</h2>
          <div style="display:flex;gap:12px;align-items:flex-start">
            <span class="icon-tile" style="width:36px;height:36px;border-radius:10px;font-weight:800" aria-hidden="true">М</span>
            <div><div style="font-weight:700">Метро «Медведково»</div><div style="font-size:14px;color:var(--muted)">около 2,3 км; также «Бабушкинская», «Бибирево»</div></div>
          </div>
          <div style="display:flex;gap:12px;align-items:flex-start">
            <span class="icon-tile" style="width:36px;height:36px;border-radius:10px"><Icon name="bus" size={18} stroke="#14171A" /></span>
            <div><div style="font-weight:700">Остановка «Вилюйская улица»</div><div style="font-size:14px;color:var(--muted)">около 740 м</div></div>
          </div>
          <div class="map" data-map>
            <button type="button" class="map__btn" data-map-load>
              <Icon name="search" size={20} />Показать карту
            </button>
            <noscript><a href={social.yandexMaps}>Открыть на Яндекс Картах</a></noscript>
          </div>
          <a href={social.yandexMaps} class="btn btn--dark" rel="noopener" target="_blank">Открыть на Яндекс Картах <span class="sr-only">(откроется в новой вкладке)</span></a>
        </div>
        <a href="#rekvizity" class="card service-card" style="border-radius:18px;flex-direction:row;justify-content:space-between;align-items:center;padding:20px 24px">
          <span><span style="display:block;font-weight:800;font-size:17px">Реквизиты для договора и оплаты</span><span style="font-size:14px;color:var(--muted)">ИНН 9715387698 · ОГРН 1207700275903</span></span>
          <Icon name="down" size={20} width={2.2} />
        </a>
      </div>
      <div class="on-ink" style="border-radius:24px;padding:clamp(24px,4vw,40px)">
        <CallbackForm client:visible source="contacts" dark withEmail title="Остались вопросы? Перезвоним за 30 минут" subtitle="Консультация бесплатно." phone={contacts.phone} />
      </div>
    </div>
  </section>

  <section id="rekvizity" class="container" style="padding-bottom:96px;scroll-margin-top:80px" aria-labelledby="req-h">
    <div class="card" style="border-radius:24px;padding:0;overflow:hidden">
      <div style="padding:24px clamp(20px,3vw,36px);border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:16px">
        <div>
          <h2 class="h2" id="req-h" style="font-size:clamp(22px,2.6vw,30px)">Карточка организации</h2>
          <div style="margin-top:4px;color:var(--muted);font-size:15px">Реквизиты для договора и оплаты</div>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px">
          <button type="button" class="btn btn--outline btn--sm" data-copy={copyText}>
            <Icon name="copy" size={18} /><span data-copy-label>Скопировать реквизиты</span>
          </button>
          <a href="/api/card-pdf" class="btn btn--dark btn--sm" download="karta-predpriyatiya-nic-smk.pdf"><Icon name="download" size={18} />Скачать карточку предприятия (PDF)</a>
        </div>
        <span class="sr-only" role="status" data-copy-status></span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,520px),1fr))">
        {groups.map((g) => (
          <div style="padding:8px clamp(20px,3vw,36px) 20px">
            <h3 style="margin:0;padding:16px 0 8px;font-size:12px;font-weight:800;letter-spacing:.1em;color:#6B5300">{g.title}</h3>
            <dl style="margin:0">
              {g.rows.map((r) => (
                <div class="req-row"><dt>{r.field}</dt><dd>{r.value}</dd></div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = document.querySelector('[data-copy-label]');
  const status = document.querySelector('[data-copy-status]');
  btn?.addEventListener('click', async () => {
    const text = btn.dataset.copy || '';
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      ta.remove();
    }
    if (label) label.textContent = 'Скопировано';
    if (status) status.textContent = 'Реквизиты скопированы в буфер обмена';
    setTimeout(() => { if (label) label.textContent = 'Скопировать реквизиты'; }, 2500);
  });

  // Карта Яндекса подгружается, когда блок доходит до экрана (или по кнопке)
  const map = document.querySelector<HTMLElement>('[data-map]');
  const loadMap = () => {
    if (!map || map.querySelector('iframe')) return;
    map.innerHTML = '<iframe title="Лаборатория НИЦ СМК на Яндекс Картах" src="https://yandex.ru/map-widget/v1/?oid=138955398020&z=15" allowfullscreen></iframe>';
  };
  map?.querySelector('[data-map-load]')?.addEventListener('click', loadMap);
  if (map && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); setTimeout(loadMap, 300); } }, { rootMargin: '0px' });
    io.observe(map);
  }
</script>
