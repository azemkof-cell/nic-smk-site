---
interface Props { items: [string, string][]; soft?: boolean; min?: number }
const { items, soft = false, min = 260 } = Astro.props;
---
<ol class="grid" style={`grid-template-columns:repeat(auto-fit,minmax(min(100%,${min}px),1fr));margin:0;padding:0;list-style:none`}>
  {items.map(([t, d], i) => (
    <li class={soft ? 'card card--soft' : 'card card--plain'} style="padding:24px">
      <div class="num-tag" aria-hidden="true">{String(i + 1).padStart(2, '0')}</div>
      <h3 class="card-title" style="margin-top:10px">{t}</h3>
      <p style="margin:6px 0 0;color:var(--muted)">{d}</p>
    </li>
  ))}
</ol>
