# Сервер
PORT=4321
HOST=0.0.0.0
# Каталог для счётчика КП, сформированных КП и журнала заявок (на сервере в РФ)
DATA_DIR=./storage
# Подпись и печать для PDF КП (НЕ в public/)
PRIVATE_DIR=./private
# Путь к Chromium/Google Chrome для PDF (install.sh заполняет сам)
CHROMIUM_PATH=

# Почта (Яндекс 360: smtp.yandex.ru, 465, SSL)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ooo.nic-smk@yandex.ru
SMTP_PASS=
MAIL_FROM=ООО «НИЦ СМК» <ooo.nic-smk@yandex.ru>
MAIL_TO=ooo.nic-smk@yandex.ru

# Telegram-бот для дублей заявок — необязательно. Если api.telegram.org недоступен,
# заявки всё равно уходят на почту. TG_API_BASE — свой прокси к Bot API (если нужен).
TG_BOT_TOKEN=
TG_CHAT_ID=-5305988730
TG_API_BASE=
TG_TIMEOUT_MS=8000

# Лимит заявок с одного IP в час
LEAD_LIMIT_PER_HOUR=5

# Яндекс.Метрика (номер счётчика; подставляется при сборке, грузится после согласия на cookie)
PUBLIC_YM_ID=113721593
